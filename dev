#!/bin/sh
set -e

case "$1" in
  update)
    echo "[dev] Building C++ backend and syncing bindings..."
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build --parallel

    echo "[dev] Syncing headers..."
    rm -rf r/inst/include/amsim
    mkdir -p r/inst/include
    cp -r include/amsim r/inst/include/

    echo "[dev] Syncing backend sources..."
    mkdir -p r/src
    rsync -a --delete --exclude 'bindings.cpp Makevars Makevars.win' src/ r/src/

    echo "[dev] Done."
    ;;

  clean)
    echo "[dev] Cleaning build artefacts and synced files..."
    rm -rf build
    rm -rf r/inst/include/amsim
    echo "[dev] Done."
    ;;

  *)
    echo "Usage: ./dev {update|clean}"
    exit 1
    ;;
esac
